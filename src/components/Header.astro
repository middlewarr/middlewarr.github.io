---
import BrandMark from "./BrandMark.astro";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" translate="no" href="#top" aria-label="Middlewarr home"
      ><span class="brand-tile"><BrandMark class="brand-mark" /></span><span
        >Middlewarr</span
      ></a
    >
    <nav aria-label="Primary navigation">
      <a
        class="github-icon-button"
        href="https://github.com/middlewarr/middlewarr"
        aria-label="View Middlewarr on GitHub"
        ><svg
          data-icon="github"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="currentColor"
          ><path
            d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a10.9 10.9 0 0 1 5.75 0C16.84 5 17.8 5.31 17.8 5.31c.63 1.58.24 2.75.12 3.04.73.8 1.17 1.82 1.17 3.08 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.3c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
          ></path></svg
        ></a
      >
      <a class="nav-link" href="https://docs.middlewarr.dev/">Documentation</a>
      <a class="button button-primary nav-cta" href="#get-started"
        >Get Started</a
      >
    </nav>
  </div>
</header>
